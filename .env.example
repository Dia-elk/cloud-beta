# Copy to .env and replace every value marked REPLACE. Never commit .env.
# Generate strong values with: openssl rand -hex 32

POSTGRES_USER=cloud_owner
POSTGRES_PASSWORD=REPLACE-with-openssl-rand-hex-32
POSTGRES_DB=cloudbeta
APP_DB_PASSWORD=REPLACE-with-a-different-openssl-rand-hex-32

# At least 32 characters; the gateway refuses to start otherwise.
JWT_SECRET=REPLACE-with-openssl-rand-hex-32-at-least-32-chars

# Browser-facing URLs (inlined into the frontends at build time).
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
NEXT_PUBLIC_SAMPLE_APP_URL=http://localhost:3001
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000

# Origins allowed to call the gateway with session cookies.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# true when served over HTTPS; false for plain http://localhost.
COOKIE_SECURE=false

# MCP server (docker compose run --rm -i mcp): a token from login, never committed.
MCP_TOKEN=
MCP_COMPANY_ID=
